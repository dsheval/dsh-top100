# Required for scheduled collection. Fine-grained token with public repository read access.
GITHUB_TOKEN=

# Paid requests are paused by default across summaries, categories, tags, packs and enrich CLI.
# This release also blocks real requests until budget protection is accepted; 1 alone cannot enable them.
DSH_MODEL_REQUESTS_ENABLED=0
# Optional credential; it never enables model requests by itself. Existing same-source content is reused.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
# Fixed configured ID; do not automatically migrate aliases. Paid calls remain blocked.
# Provider now routes this legacy ID to V4.1 Flash; re-approval is required before resuming.
DEEPSEEK_MODEL=deepseek-v4-flash
# Common summary/classification output default; explicit non-thinking requests.
DEEPSEEK_MAX_TOKENS=256
# 通用简介请求（如插件包介绍）的重试与超时。每日条目队列固定单次请求、45秒超时，失败持久退避。
DEEPSEEK_SUMMARY_ATTEMPTS=2
DEEPSEEK_SUMMARY_TIMEOUT_MS=45000
# 每日条目中文队列的请求上限与并发数；不包含标签归一化或插件包介绍。
DEEPSEEK_SUMMARY_BATCH_SIZE=300
DEEPSEEK_SUMMARY_CONCURRENCY=3
# 每次更新最多补齐多少个 README 分类；设为 0 不领取新分类任务，保留有效已有分类。
DEEPSEEK_CATEGORY_BATCH_SIZE=200
# 每轮只读核对安装源清单元数据；成功/结构失败7天过期，网络失败次日重试。0为离线模式。
INSTALL_ASSESSMENT_BATCH_SIZE=100

# Web and scheduler settings.
WEB_PORT=8080
TZ=Asia/Shanghai
COLLECT_HOUR=6
FULL_DISCOVERY_WEEKDAY=0
RUN_COLLECT_ON_STARTUP=false
DSH_DISCOVERY_MODE=incremental
DSH_INCREMENTAL_REPOSITORY_PAGES=2

# Local non-Docker paths. Docker Compose overrides these container paths.
DATABASE_PATH=runtime/dsh-top100.sqlite
SOURCE_DATA_PATH=data/plugins.json
PUBLIC_DATA_DIR=runtime/public-data

# Repository structure reads; independent from LLM worker concurrency (1–50).
DSH_COLLECTION_CONCURRENCY=10
